MODE=mock
PORT=8787
# Downlink voice bitrate: 8000 / 12000 / 16000 (default). Keeps 24 kHz and 20 ms frames.
# OPUS_DOWNLINK_BITRATE=8000
DEVICE_TOKEN=change-this-device-token
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
# Optional: reuse Codex Pocket Cloud native voice, no OpenAI API key.
# MODE=pocket
# POCKET_URL=ws://pocket-backend:8789/voxi
# POCKET_DEVICE_TOKEN=the-existing-pocket-device-bearer
